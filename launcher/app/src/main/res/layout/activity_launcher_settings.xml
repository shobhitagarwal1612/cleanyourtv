<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0D0F14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="110dp"
        android:paddingEnd="110dp"
        android:paddingTop="32dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:fontFamily="@string/font_medium"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp" />

        <!-- Section 1: Ambient & Home -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/glass_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="Ambient &amp; Home" />

            <TextView
                android:id="@+id/wallpaperChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/dailyWhisperChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/idleActionChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dream_name"
                android:fontFamily="@string/font_medium"
                android:textColor="#D9FFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/clockSystem" style="@style/SettingsColumnChoice" android:text="@string/clock_format_system" />
                <TextView android:id="@+id/clock12" style="@style/SettingsColumnChoice" android:text="@string/clock_format_12" />
                <TextView android:id="@+id/clock24" style="@style/SettingsColumnChoice" android:layout_marginEnd="0dp" android:text="@string/clock_format_24" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 2: Layout & Motion -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/glass_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="Layout &amp; Motion" />

            <TextView
                android:id="@+id/reorderChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="12dp"
                android:text="@string/reorder"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/columns_label"
                android:fontFamily="@string/font_medium"
                android:textColor="#D9FFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:layout_marginEnd="0dp" android:text="7" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/rows_below_dock_label"
                android:fontFamily="@string/font_medium"
                android:textColor="#D9FFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:layout_marginEnd="0dp" android:text="3" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/dock_opacity_label"
                android:fontFamily="@string/font_medium"
                android:textColor="#D9FFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
                <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
                <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
                <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:layout_marginEnd="0dp" android:text="30%" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/animationsChoice"
                    style="@style/SettingsColumnChoice" />

                <TextView
                    android:id="@+id/advancedChoice"
                    style="@style/SettingsColumnChoice"
                    android:layout_marginEnd="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 3: System -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/glass_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="System" />

            <TextView
                android:id="@+id/openOnStartChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/followThemeChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="12dp"
                android:text="@string/follow_theme" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSettingsChoice"
                    style="@style/SettingsColumnChoice"
                    android:text="@string/tv_settings" />

                <TextView
                    android:id="@+id/defaultHomeChoice"
                    style="@style/SettingsColumnChoice"
                    android:layout_marginEnd="0dp"
                    android:text="@string/home_settings" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
